# Copie para .env e preencha. Para desenvolvimento e testes locais, use o Supabase Preview:
# os testes E2E criam e apagam pedidos e não podem rodar contra produção.

# Aplicação (Supabase Preview → Project Settings → API)
VITE_SUPABASE_PROJECT_ID="ref_do_projeto_preview"
VITE_SUPABASE_PUBLISHABLE_KEY="chave_publica_do_projeto_preview"
VITE_SUPABASE_URL="https://ref_do_projeto_preview.supabase.co"

# Testes E2E (Supabase Preview → Connect → Session pooler)
DATABASE_URL="postgresql://postgres.ref_do_projeto_preview:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Travas de ambiente dos testes E2E
SUPABASE_PREVIEW_PROJECT_ID="ref_do_projeto_preview"
SUPABASE_PROD_PROJECT_ID="ref_do_projeto_producao"
